nts":null,"x":705,"angle":0,"y":211.5,"width":633.59979248046875},{"seed":83858065,"strokeStyle":"solid","id":"Cserslw-VqEII0oGsKzBn","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1788428079235,"locked":false,"text":"Questions\n\n- How many languages (Python, Java, C)\n- Single file?\n- Evaluate against TestCases?\n\n\nFunctional Requirements\n\n- Users can submit code for given question\n- System should evaluate and see how many test cases passes or error?\n\n\nNon Functional Requirements\n\n- Highly Scalable (too support multiple submissions and evaluations)\n- Should not affect others submissions (Isolation)\n\n\nAssumptions\n\n- 1M DAU\n- 5 Problems a day\n- 2 retries avg\n- 2x5x1M - 10M Executions\/day - 10x10^6\/10^5 - 100 Executions\/Sec\n\n\n","version":520,"autoResize":true,"type":"text","backgroundColor":"transparent","index":"a2","roundness":null,"containerId":null,"originalText":"Questions\n\n- How many languages (Python, Java, C)\n- Single file?\n- Evaluate against TestCases?\n\n\nFunctional Requirements\n\n- Users can submit code for given question\n- System should evaluate and see how many test cases passes or error?\n\n\nNon Functional Requirements\n\n- Highly Scalable (too support multiple submissions and evaluations)\n- Should not affect others submissions (Isolation)\n\n\nAssumptions\n\n- 1M DAU\n- 5 Problems a day\n- 2 retries avg\n- 2x5x1M - 10M Executions\/day - 10x10^6\/10^5 - 100 Executions\/Sec\n\n\n","height":700,"link":null,"strokeColor":"#1e1e1e","fillStyle":"solid","groupIds":[],"versionNonce":766488799,"textAlign":"left","fontFamily":8,"lineHeight":1.25,"frameId":null,"boundElements":null,"x":472,"angle":0,"y":676.5,"width":759},{"seed":868895039,"strokeStyle":"solid","id":"x5l-aW9RsZgVoEWDIWwC4","strokeWidth":2,"roughness":1,"isDeleted":false,"fontSize":20,"opacity":100,"verticalAlign":"top","updated":1788428156314,"locked":false,"text":"High Level Design","version":19,"auto